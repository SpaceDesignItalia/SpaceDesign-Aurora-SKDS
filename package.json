{
  "name": "spacedesign-aurora-skds",
  "version": "1.0.0",
  "description": "Monorepo contenente librerie per React, Vue e Express",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:react": "cd packages/react-library && npm run build",
    "build:vue": "cd packages/vue-library && npm run build",
